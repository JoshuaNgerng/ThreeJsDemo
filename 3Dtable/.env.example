# Copy to .env.local and fill in. Never commit real values.

# From the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
VITE_SPREADSHEET_ID=

# API key restricted to the Google Sheets API (and to your site's referrers)
VITE_GOOGLE_API_KEY=

# OAuth 2.0 Web client ID (Google Auth Platform -> Clients)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
